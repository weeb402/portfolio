#!/bin/sh
# Pre-commit secret scanner (baseline hardening).
# Fast staged-diff heuristic scan; complements gitleaks (see .gitleaks.toml).
# Emergency bypass: git commit --no-verify (use sparingly, audit afterwards).

PATTERNS='AKIA[A-Z0-9]{16}|ASIA[A-Z0-9]{16}|-----BEGIN (RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY|xox[baprs]-[A-Za-z0-9-]{10,}|ghp_[A-Za-z0-9]{36}|gho_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|AIza[0-9A-Za-z_-]{35}|glpat-[A-Za-z0-9_-]{20,}|eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9'

ALLOWLIST='(AKIAIOSFODNN7EXAMPLE|wJalrXUtnFEMI|your[-_]?key[-_]?here|placeholder|changeme|dummy|example[-_]?(key|secret|token)|xxxxx|\$\{[A-Za-z0-9_]+\}|process\.env\.|os\.Getenv|test[-_]?(key|token|secret|password)|<[^>]*>|\b(hash|digest|sha256|signature|hmac)\b)'

ADDED=$(git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++' )
if [ -z "$ADDED" ]; then
  exit 0
fi

VIOLATIONS=$(printf '%s\n' "$ADDED" \
  | grep -E "$PATTERNS" \
  | grep -viE "$ALLOWLIST" || true)

if [ -n "$VIOLATIONS" ]; then
  echo ""
  echo "======================================================================"
  echo " PRE-COMMIT SECRET SCAN: potential secrets detected in staged changes"
  echo "======================================================================"
  printf '%s\n' "$VIOLATIONS" | cut -c1-200
  echo "----------------------------------------------------------------------"
  echo " Remove the secret(s), move them to environment variables (.env, not"
  echo " committed), or bypass with: git commit --no-verify"
  echo "======================================================================"
  exit 1
fi

exit 0
